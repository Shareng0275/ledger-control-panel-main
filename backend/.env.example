# Application Environment
ENVIRONMENT=production
DEBUG=false
APP_NAME=Ledger Control API

# Database Connectivity (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ledger_control

# Security & JWT Secrets
SECRET_KEY=change_this_in_production_to_a_secure_random_hex_string_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://app.ledgercontrol.com"]

# File Storage Configuration
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=26214400

# AI Provider Keys (Optional: Anthropic / OpenAI / Gemini / Deterministic Fallback)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=claude-3-5-sonnet-20241022

# Reconciliation Matching Engine Weights
FUZZY_WEIGHT_AMOUNT=0.35
FUZZY_WEIGHT_DATE=0.25
FUZZY_WEIGHT_DESCRIPTION=0.30
FUZZY_WEIGHT_REFERENCE=0.10
FUZZY_AUTO_MATCH_THRESHOLD=0.88
FUZZY_PENDING_REVIEW_THRESHOLD=0.65
