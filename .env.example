# =============================================================================
# LEDGER CONTROL — MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Track: AI Finance Controller (Razorpay AI Buildathon)
# Stack: Node.js, TypeScript, Express, PostgreSQL, Prisma, Redis, BullMQ, JWT, AI/LLM, Razorpay
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# -----------------------------------------------------------------------------
# Application execution environment (development | test | production)
NODE_ENV=development

# Port where Express backend server binds
PORT=8000

# Base URL of frontend application (used for CORS and redirect resolution)
FRONTEND_URL=http://localhost:5173

# Allowed origins for CORS headers (comma-separated for multi-origin support)
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# 2. FRONTEND VITE ENVIRONMENT
# -----------------------------------------------------------------------------
# Base URL for frontend API client communication
VITE_API_BASE_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# 3. DATABASE & ORM CONFIGURATION (PostgreSQL + Prisma)
# -----------------------------------------------------------------------------
# Connection URI for PostgreSQL database (or file:./dev.db for zero-config SQLite)
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/ledger_control?schema=public

# -----------------------------------------------------------------------------
# 4. REDIS & BACKGROUND JOB QUEUES (BullMQ)
# -----------------------------------------------------------------------------
# Connection URI for Redis server (queue worker and rate limiting)
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# 5. AUTHENTICATION & JWT SECURITY
# -----------------------------------------------------------------------------
# Secret key for short-lived access tokens (minimum 32 characters)
JWT_SECRET=replace_with_64_character_random_hex_access_secret_key

# Secret key for long-lived refresh tokens (minimum 32 characters)
JWT_REFRESH_SECRET=replace_with_64_character_random_hex_refresh_secret_key

# Access token expiration time (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token expiration time (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# 6. AI / LLM FINANCIAL INTELLIGENCE INTEGRATION
# -----------------------------------------------------------------------------
# Provider API key for financial analysis assistant
LLM_API_KEY=your_ai_provider_api_key_here

# Specific LLM model version
LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# 7. RAZORPAY PAYMENT GATEWAY & WEBHOOK INTEGRATION
# -----------------------------------------------------------------------------
# Razorpay Key ID
RAZORPAY_KEY_ID=rzp_test_SampleKeyId12345

# Razorpay Key Secret
RAZORPAY_KEY_SECRET=SampleRazorpayKeySecretDoNotCommitRealSecrets

# Razorpay Webhook Signature Secret
RAZORPAY_WEBHOOK_SECRET=SampleWebhookSecretForHMACVerification
