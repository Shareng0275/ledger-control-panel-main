{
  "name": "ledger-control-backend",
  "version": "1.0.0",
  "description": "Production Node.js TypeScript Express backend for Ledger Control AI Finance Controller",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "tsx src/workers/reconciliationWorker.ts",
    "prisma:generate": "prisma generate",
