# =============================================================================
# LEDGER CONTROL — BACKEND ENVIRONMENT TEMPLATE (server/.env.example)
# =============================================================================

PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL for Production or file:./dev.db for SQLite local dev)
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/ledger_control?schema=public

# Redis & Job Queues
REDIS_URL=redis://localhost:6379

# Authentication & JWT Secrets
JWT_SECRET=super_secret_jwt_access_key_32_bytes_long_here_for_development
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_32_bytes_long_here_for_development
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Storage & Engine Rules
STORAGE_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=25
FUZZY_AUTO_MATCH_THRESHOLD=0.88
FUZZY_REVIEW_THRESHOLD=0.65

# Optional Integrations
LLM_API_KEY=your_ai_api_key_here
LLM_MODEL=gpt-4o-mini
RAZORPAY_KEY_ID=rzp_test_SampleKeyId12345
RAZORPAY_KEY_SECRET=SampleKeySecretDoNotCommit
RAZORPAY_WEBHOOK_SECRET=SampleWebhookSecret
